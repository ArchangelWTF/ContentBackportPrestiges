<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ReleaseOutputDir>..\Build\SPT_Runtime\user\mods\archangelwtf-contentbackportprestiges\</ReleaseOutputDir>
    <Version>1.1.0</Version>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="SPTarkov.Common" Version="4.1.0" />
    <PackageReference Include="SPTarkov.DI" Version="4.1.0" />
    <PackageReference Include="SPTarkov.Reflection" Version="4.1.0" />
    <PackageReference Include="SPTarkov.Server.Core" Version="4.1.0" />
    <PackageReference Include="SPTarkov.Server.Web" Version="4.1.0" />
    <PackageReference Include="WTT-ServerCommonLib" Version="3.0.3" />
  </ItemGroup>
  <ItemGroup>
    <None Update="db\**">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
  </ItemGroup>
  <!-- Generate constants from the MSBuild Version so ModMetadata stays in sync -->
  <Target Name="GenerateModInfo" BeforeTargets="CoreCompile">
    <PropertyGroup>
      <ModInfoFile>$(IntermediateOutputPath)ContentBackportPrestigesCompileConstants.g.cs</ModInfoFile>
    </PropertyGroup>
    <ItemGroup>
      <ModInfoLines Include="// &lt;auto-generated /&gt; Generated by the GenerateModInfo build target." />
      <ModInfoLines Include="namespace ContentBackportPrestigesServer" />
      <ModInfoLines Include="{" />
      <ModInfoLines Include="    internal static class ContentBackportPrestigesCompileConstants" />
      <ModInfoLines Include="    {" />
      <ModInfoLines Include="        public const string MOD_VERSION = &quot;$(Version)&quot;%3B" />
      <ModInfoLines Include="    }" />
      <ModInfoLines Include="}" />
    </ItemGroup>
    <WriteLinesToFile File="$(ModInfoFile)" Lines="@(ModInfoLines)" Overwrite="true" WriteOnlyWhenDifferent="true" />
    <ItemGroup>
      <Compile Include="$(ModInfoFile)" />
      <FileWrites Include="$(ModInfoFile)" />
    </ItemGroup>
  </Target>

  <!-- Build script for release build-->
  <Target Name="CleanUnwantedFiles" AfterTargets="Build">
    <ItemGroup>
      <UnwantedFiles Include="$(OutputPath)*.pdb;$(OutputPath)*.deps.json;$(OutputPath)*.endpoints.json;$(OutputPath)*.runtimeconfig.*;$(OutputPath)*.staticwebassets.*" />
    </ItemGroup>
    <Delete Files="@(UnwantedFiles)" />
  </Target>
  <Target Name="CopyBuildOutput" AfterTargets="CleanUnwantedFiles">
    <MakeDir Directories="$(ReleaseOutputDir)" />
    <ItemGroup>
      <RemainingFiles Include="$(OutputPath)**\*" />
      <WebAssets Include="$(ProjectDir)wwwroot\**\*.*" />
    </ItemGroup>
    <Copy
      SourceFiles="@(RemainingFiles)"
      DestinationFiles="@(RemainingFiles->'$(ReleaseOutputDir)%(RecursiveDir)%(Filename)%(Extension)')"
    />
    <Copy SourceFiles="@(WebAssets)" DestinationFiles="@(WebAssets->'$(ReleaseOutputDir)wwwroot\%(RecursiveDir)%(Filename)%(Extension)')" />
  </Target>
  <Target Name="CopyToServerMods" AfterTargets="CopyBuildOutput" Condition="'$(Configuration)' == 'Debug'">
    <PropertyGroup>
      <ServerModsDir>..\..\SPT\server-csharp\SPTushonka.Server\bin\Debug\$(TargetFramework)\user\mods\archangelwtf-contentbackportprestiges\</ServerModsDir>
    </PropertyGroup>
    <MakeDir Directories="$(ServerModsDir)" />
    <ItemGroup>
      <ModFiles Include="$(ReleaseOutputDir)**\*.*" />
    </ItemGroup>
    <Copy SourceFiles="@(ModFiles)" DestinationFiles="@(ModFiles->'$(ServerModsDir)%(RecursiveDir)%(Filename)%(Extension)')" />
  </Target>
</Project>
